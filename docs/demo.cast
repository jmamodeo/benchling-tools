[4.38,"o","# 2. Preview: reads Benchling, writes nothing remotely\n"]
[4.53,"o","\n"]
[4.98,"o","$ benchling-tools changes plan --entry etr_abc123 --family table --spec set-cell-b2.json --env demo\n"]
