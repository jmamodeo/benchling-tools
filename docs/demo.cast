[1.82,"o","# 1. Read an entry (envelope trimmed for readability)\n"]
[1.97,"o","\n"]
[2.42,"o","$ benchling-tools entry inspect etr_abc123 --env demo\n"]
[2.45,"o","{\n"]
[2.48,"o","  \"ok\": true,\n"]
