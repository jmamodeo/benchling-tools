{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/benchling-tools/change-spec.schema.json",
  "title": "Benchling Toolkit Change Specification",
  "description": "Select the matching object for the --family argument. Container operations use the containers family and do not require an entry.",
  "$defs": {
    "fieldValueInput": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value"],
      "properties": { "value": {} }
    }
  },
  "oneOf": [
    {
      "title": "Create entry from template",
      "type": "object",
      "additionalProperties": false,
      "required": ["entry_template_id", "folder_id", "name"],
      "properties": {
        "entry_template_id": { "type": "string", "minLength": 1 },
        "folder_id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "schema_fields": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fieldValueInput" }
        }
      }
    },
    {
      "title": "Document change",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "parts"],
          "properties": {
            "operation": { "const": "insert" },
            "position": {
              "type": "string",
              "default": "end_of_document",
              "description": "beginning_of_document, end_of_document, or a part ID. A part ID inserts immediately before that part."
            },
            "parts": { "type": "array", "minItems": 1, "items": { "type": "object" } }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "from_part_id"],
          "properties": {
            "operation": { "const": "delete" },
            "from_part_id": { "type": "string" },
            "to_part_id": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "from_part_id", "position"],
          "properties": {
            "operation": { "const": "move" },
            "from_part_id": { "type": "string" },
            "to_part_id": { "type": "string" },
            "position": {
              "type": "string",
              "description": "beginning_of_document, end_of_document, or a part ID. A part ID moves the range immediately before that part."
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["operation", "part_id", "text"],
          "properties": {
            "operation": { "const": "replace_text" },
            "part_id": { "type": "string" },
            "text": { "type": "string" },
            "formats": { "type": "array" },
            "links": { "type": "array" },
            "mentions": { "type": "array" },
            "indentation": { "type": "integer", "minimum": 0 }
          }
        }
      ]
    },
    {
      "title": "Table change",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "table_part_id"],
      "properties": {
        "operation": { "enum": ["set_cells", "append_rows"] },
        "table_part_id": { "type": "string", "pattern": "^docpart_" },
        "updates": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["row", "column", "value"],
            "properties": {
              "row": { "type": "integer", "minimum": 0 },
              "column": { "type": "integer", "minimum": 0 },
              "value": {}
            }
          }
        },
        "rows": { "type": "array", "minItems": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "operation": { "const": "set_cells" } } },
          "then": { "required": ["updates"] }
        },
        {
          "if": { "properties": { "operation": { "const": "append_rows" } } },
          "then": { "required": ["rows"] }
        }
      ]
    },
    {
      "title": "Entry-field change",
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_fields"],
      "properties": {
        "schema_fields": {
          "description": "Keys are V3 field system names or field-definition IDs. Plans resolve either form to the field-definition ID, show both identifiers in the preview, and send the ID.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/fieldValueInput" }
        }
      }
    },
    {
      "title": "Result upload",
      "type": "object",
      "additionalProperties": false,
      "required": ["table_id", "assay_results"],
      "properties": {
        "table_id": { "type": "string", "pattern": "^strtbl_" },
        "assay_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["schemaId", "fields"],
            "properties": {
              "schemaId": { "type": "string" },
              "projectId": { "type": ["string", "null"] },
              "fields": {
                "type": "object",
                "additionalProperties": { "$ref": "#/$defs/fieldValueInput" },
                "description": "Result fields. On an attachment field, a value of {\"file\": PATH} (optional blob_type RAW_FILE or VISUALIZATION, optional mime_type) uploads that local file as a blob at apply and links its blob ID. A relative PATH is resolved against the current directory."
              }
            }
          }
        }
      }
    },
    {
      "title": "Multi-table result upload",
      "type": "object",
      "additionalProperties": false,
      "required": ["batches"],
      "properties": {
        "batches": {
          "type": "array",
          "minItems": 1,
          "description": "Table-specific result batches. Each table can contain at most 500 records.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["table_id", "assay_results"],
            "properties": {
              "table_id": { "type": "string", "pattern": "^strtbl_" },
              "assay_results": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["schemaId", "fields"],
                  "properties": {
                    "schemaId": { "type": "string" },
                    "projectId": { "type": ["string", "null"] },
                    "fields": {
                      "type": "object",
                      "additionalProperties": { "$ref": "#/$defs/fieldValueInput" },
                      "description": "Result fields. On an attachment field, a value of {\"file\": PATH} (optional blob_type RAW_FILE or VISUALIZATION, optional mime_type) uploads that local file as a blob at apply and links its blob ID. A relative PATH is resolved against the current directory."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "title": "Result update from CSV",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "csv_path", "id_column", "column_map"],
      "properties": {
        "operation": { "const": "update" },
        "csv_path": {
          "type": "string",
          "minLength": 1,
          "description": "Path to a CSV file. Assay-result export writes a file this planner can read."
        },
        "id_column": {
          "type": "string",
          "minLength": 1,
          "description": "CSV header that holds the result id. Export writes this column as id."
        },
        "column_map": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "minLength": 1 },
          "description": "CSV header to a field display name, system name, or field-definition id. The plan resolves each one to a field-definition id and does not send the display name. In an attachment column, a cell file:PATH uploads that local file (PATH relative to the CSV's folder) and any other text is a blob ID."
        }
      }
    },
    {
      "title": "Container creation",
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "schema_id"],
      "properties": {
        "operation": { "const": "create" },
        "schema_id": { "type": "string", "minLength": 1 },
        "name": { "type": ["string", "null"] },
        "barcode": { "type": ["string", "null"] },
        "project_id": { "type": ["string", "null"] },
        "parent_storage_id": { "type": ["string", "null"] },
        "fields": { "type": ["object", "null"] },
        "restricted_sample_party_ids": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "restriction_status": { "type": ["string", "null"] },
        "sample_owner_ids": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    },
    {
      "title": "Container transfer",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operation",
        "source_container_id",
        "destination_container_id",
        "destination_contents"
      ],
      "properties": {
        "operation": { "const": "transfer" },
        "source_container_id": { "type": "string", "minLength": 1 },
        "destination_container_id": { "type": "string", "minLength": 1 },
        "transfer_quantity": { "type": ["object", "null"] },
        "destination_contents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["entity_id"],
            "properties": {
              "entity_id": { "type": "string", "minLength": 1 },
              "concentration": { "type": ["object", "null"] }
            }
          }
        },
        "destination_quantity": { "type": ["object", "null"] },
        "restricted_sample_party_ids": {
          "type": ["array", "null"],
          "items": { "type": "string" }
        },
        "restriction_status": { "type": ["string", "null"] },
        "sample_owner_ids": { "type": ["array", "null"], "items": { "type": "string" } }
      }
    }
  ]
}
