{
  "description": "Query parameters this client may send on supported read routes. A request may use a subset. V3 entry listing has no folder parameter; folderId is only sent to V2 /entries. V2 name is a single entry name and is sent when that name contains a comma. A results-table row page sends pageSize and nextToken only.",
  "routes": {
    "GET /api/v3/entry/items": [
      "pageSize",
      "nextToken",
      "project.eq",
      "schema.eq",
      "name.anyOf",
      "modifiedAt.gte",
      "modifiedAt.lte"
    ],
    "GET /api/v2/entries": [
      "pageSize",
      "nextToken",
      "folderId",
      "projectId",
      "schemaId",
      "names.anyOf",
      "name",
      "modifiedAt",
      "displayIds"
    ],
    "GET /api/v2/entries:bulk-get": ["entryIds", "displayIds"],
    "GET /api/v2/containers:bulk-get": ["containerIds"],
    "GET /api/v2/entry-templates": ["pageSize", "nextToken", "name"],
    "GET /api/v3/document-part-results-table/{document_part_results_table_id}/rows/items": [
      "pageSize",
      "nextToken"
    ],
    "GET /api/v3/entry-schema/items": ["pageSize", "nextToken"],
    "GET /api/v3/result-schema/items": ["pageSize", "nextToken"],
    "GET /api/v3/run-schema/items": ["pageSize", "nextToken"]
  }
}
